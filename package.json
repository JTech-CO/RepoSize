{
  "name": "reposize",
  "version": "1.0.1",
  "description": "Show accurate repository size on GitHub before you download or clone.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/selftest.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/reposize-selftest.mjs --log-level=warning && node node_modules/.cache/reposize-selftest.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:watch": "vite build --watch --mode development",
    "preview": "vite preview",
    "zip": "node scripts/zip.mjs",
    "package": "npm run build:win && npm run zip",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
